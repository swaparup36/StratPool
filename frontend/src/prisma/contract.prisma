// use prisma-8

// user
model User {
  id        String             @id @onCreate(uuid())
  email     String             @unique
  firstName String
  lastName  String
  username  String             @unique
  address   String             @unique
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

// strategy
enum TradingType {
  SPOT
  PERPETUALS
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum StrategyStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

model Strategy {
  id          String         @id @onCreate(uuid())
  strategistId String

  name        String
  description String

  // Market information
  chain       String
  tradingType TradingType
  tradingPair String
  protocol    String
  poolAddress String?

  // Capital requirements
  acceptedAssets StrategyAcceptedAsset[]

  riskLevel   RiskLevel

  // React Flow graph stored as JSONB
  graph       Json

  graphVersion Int @default(1)

  status      StrategyStatus @default(DRAFT)
  isVerified Boolean @default(false)

  createdAt   DateTime @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt

  strategist  User @relation(
    fields: [strategistId],
    references: [id]
  )

  @@index([strategistId])
  @@index([chain, tradingType, tradingPair])
  @@index([status])
}

model StrategyAcceptedAsset {
  id String @id @onCreate(uuid())
  strategyId String

  chainId    Int
  tokenAddress String
  symbol     String
  decimals   Int

  minInvestment Numeric(78, 0)
  maxInvestment Numeric(78, 0)?

  strategy Strategy @relation(fields: [strategyId], references: [id])

  @@unique([strategyId, chainId, tokenAddress])
}

// requirements
enum DurationType {
  FIXED
  FLEXIBLE
}

enum DurationUnit {
  DAYS
  MONTHS
}

enum RequirementStatus {
  OPEN
  MATCHED
  CLOSED
}

model InvestorRequirement {
  id         String @id @onCreate(uuid())
  investorId String

  // Investment preferences
  amount String
  asset  String
  chain  String

  // Market preferences
  tradingType  TradingType
  tradingPairs String[]
  riskLevel    RiskLevel

  // Investment duration
  durationType  DurationType
  durationValue Int?
  durationUnit  DurationUnit?

  status RequirementStatus @default(OPEN)

  createdAt DateTime @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  investor User @relation(
    fields: [investorId],
    references: [id]
  )

  @@index([investorId])
  @@index([status])
  @@index([chain, tradingType])
}

// Backtest results
model BacktestResult {
  id String @id @onCreate(uuid())
  strategyId String
  netReturnPct Numeric
  maxDrawdownPct Numeric
  totalTrades Int
  initialCapital Numeric
  finalEquity Numeric
  periodStart DateTime
  periodEnd DateTime
  createdAt DateTime @default(now()) @onCreate(now())

  strategy Strategy @relation(fields: [strategyId], references: [id])
  
  @@index([strategyId, createdAt])
}

// one strategy serving one requirement, and the CRE workflow that runs it. Its id tags every trade on-chain.
model strategyAssignment {
  id String @id @onCreate(uuid())
  strategyId String
  requirementId String
  assignedAt DateTime @default(now()) @onCreate(now())
  deployedAt DateTime?

  strategy Strategy @relation(fields: [strategyId], references: [id])
  requirement InvestorRequirement @relation(fields: [requirementId], references: [id])

  @@unique([strategyId, requirementId])
}

// closed trades indexed from CommissionManager's TradeClosed. Amounts are in base units of token.
model Trade {
  id String @id @onCreate(uuid())
  assignmentId String
  chainId Int
  token String
  cost Numeric(78, 0)
  proceeds Numeric(78, 0)
  commission Numeric(78, 0)
  txHash String
  logIndex Int
  blockNumber Int
  closedAt DateTime

  assignment strategyAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([chainId, txHash, logIndex])
  @@index([assignmentId])
}