{
  "name": "workflow-engine",
  "version": "1.0.0",
  "description": "Turns a strategy graph into a Chainlink CRE workflow and simulates it.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "indexer": "tsx src/indexer.ts",
    "indexer:start": "node dist/indexer.js",
    "sandbox:build": "docker build -t stratpool-cre-sandbox .",
    "test": "tsx --test src/generate.test.ts"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bullmq": "^6.7.1",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  }
}
